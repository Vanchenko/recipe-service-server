# --- сборка фронта ---
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ARG VITE_BASE=/
ENV VITE_API_URL=$VITE_API_URL VITE_BASE=$VITE_BASE
RUN npm run build

# --- Caddy: раздаёт статику и проксирует /api на бэкенд ---
FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY --from=deploy Caddyfile /etc/caddy/Caddyfile
